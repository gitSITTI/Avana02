   "link": null,
   "locked": false,
   "text": "Works from systems v2 and MSoSA models that are online, very large and shared. Wants\nfewer duplicate requirements without losing a single trace link. Must be able to\nshow a reviewer exactly why every change was made.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Works from systems v2 and MSoSA models that are online, very large and shared. Wants\nfewer duplicate requirements without losing a single trace link. Must be able to\nshow a reviewer exactly why every change was made.",
   "autoResize": true,
   "lineHeight": 1.25
  },
