   "link": null,
   "locked": false,
   "text": "Each strategy says who sets the result\n(computed, you, or AI), what it gives on\nthis example, when it fits and what to\nwatch.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each strategy says who sets the result\n(computed, you, or AI), what it gives on\nthis example, when it fits and what to\nwatch.",
   "autoResize": true,
   "lineHeight": 1.25
  },
