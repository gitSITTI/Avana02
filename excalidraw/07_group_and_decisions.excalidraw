  },
  {
   "id": "e00384",
   "type": "text",
   "x": 34,
   "y": 1670,
   "width": 429.00000000000006,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00257",
   "roundness": null,
   "seed": 1629668368,
   "version": 1,
   "versionNonce": 384744171,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2713  AI chooses a strategy and drafts the wording, with reasons and quotes. Yes.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2713  AI chooses a strategy and drafts the wording, with reasons and quotes. Yes.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00385",
   "type": "text",
   "x": 34,
   "y": 1700,
   "width": 368.50000000000006,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00257",
   "roundness": null,
   "seed": 959731461,
   "version": 1,
   "versionNonce": 545898078,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2713  You review a one-screen summary and accept, edit or reject. Yes.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2713  You review a one-screen summary and accept, edit or reject. Yes.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00386",
   "type": "text",
   "x": 34,
   "y": 1730,
   "width": 819.5000000000001,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00257",
   "roundness": null,
   "seed": 1386883456,
   "version": 1,
   "versionNonce": 1127167013,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2713  In low-risk Lane A the project may allow one-click accept per cluster, with a reason code filled in from the AI record. Optional, project setting.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2713  In low-risk Lane A the project may allow one-click accept per cluster, with a reason code filled in from the AI record. Optional, project setting.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00387",
   "type": "text",
   "x": 34,
   "y": 1760,
   "width": 731.5000000000001,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00257",
   "roundness": null,
   "seed": 1367096638,
   "version": 1,
   "versionNonce": 1333181730,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2715  AI saving a decision on its own, or accepting for you in bulk. No. \"Accept all\" is off, and guards cannot be overridden by the AI.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2715  AI saving a decision on its own, or accepting for you in bulk. No. \"Accept all\" is off, and guards cannot be overridden by the AI.",
   "autoResize": true,
   "lineHeight": 1.25
  },
