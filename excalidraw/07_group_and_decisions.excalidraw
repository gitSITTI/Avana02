   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Why keep disagreements",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why keep disagreements",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00522",
   "type": "text",
   "x": 1014,
   "y": 2510,
   "width": 429.00000000000006,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00407",
   "roundness": null,
   "seed": 352988423,
   "version": 1,
   "versionNonce": 1422975174,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "When a reviewer overrides the AI and says why, that pair becomes a labelled\nexample. The gold set (board 09) grows from real disagreements, which is where\nthe model is weakest and where the next calibration should look.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "When a reviewer overrides the AI and says why, that pair becomes a labelled\nexample. The gold set (board 09) grows from real disagreements, which is where\nthe model is weakest and where the next calibration should look.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00523",
   "type": "text",
   "x": 1014,
   "y": 2600,
   "width": 418.00000000000006,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00407",
   "roundness": null,
   "seed": 1532427709,
   "version": 1,
   "versionNonce": 1102528286,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "It also answers the audit question: what did the AI say, and what did you do\nwith it?",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It also answers the audit question: what did the AI say, and what did you do\nwith it?",
   "autoResize": true,
   "lineHeight": 1.25
  },
