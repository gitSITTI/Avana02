   "versionNonce": 652550749,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "If the AI runs again, its output arrives as a new sibling (R5-ai). It never replaces a revision a person edited. You can compare, and adopt by editing.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If the AI runs again, its output arrives as a new sibling (R5-ai). It never replaces a revision a person edited. You can compare, and adopt by editing.",
   "autoResize": true,
   "lineHeight": 1.25
  },
