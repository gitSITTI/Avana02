   "locked": false,
   "text": "Why not a separate screen: it would\nsplit evidence from the decision, add a\nstep on every cluster, and hide the\nguards. The panel collapses on small\nscreens and becomes a bottom sheet on a\nphone.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why not a separate screen: it would\nsplit evidence from the decision, add a\nstep on every cluster, and hide the\nguards. The panel collapses on small\nscreens and becomes a bottom sheet on a\nphone.",
   "autoResize": true,
   "lineHeight": 1.25
  },
