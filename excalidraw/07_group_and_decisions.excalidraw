   "text": "Not every member can be ranked. The tool\nnames those, offers keep-separate or\nask-the-owner, and never silently drops\nthem.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not every member can be ranked. The tool\nnames those, offers keep-separate or\nask-the-owner, and never silently drops\nthem.",
   "autoResize": true,
   "lineHeight": 1.25
  },
