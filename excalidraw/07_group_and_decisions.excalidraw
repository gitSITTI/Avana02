   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\"Stricter\" depends on the parameter.\nShorter latency is stricter, longer\nretention is stricter, a wider\ntemperature range is stricter. A person\nsets it once per type.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"Stricter\" depends on the parameter.\nShorter latency is stricter, longer\nretention is stricter, a wider\ntemperature range is stricter. A person\nsets it once per type.",
   "autoResize": true,
   "lineHeight": 1.25
  },
