   "link": null,
   "locked": false,
   "text": "Two records per decision: what the person said, and what the AI said",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two records per decision: what the person said, and what the AI said",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00410",
   "type": "text",
   "x": 20,
   "y": 1960,
   "width": 910.8000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00407",
   "roundness": null,
   "seed": 1729697999,
   "version": 1,
   "versionNonce": 1919799074,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "They are stored separately on purpose. The AI's reasons are explanations, not proof, and a reviewer's note is never auto-filled from them.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "They are stored separately on purpose. The AI's reasons are explanations, not proof, and a reviewer's note is never auto-filled from them.",
   "autoResize": true,
   "lineHeight": 1.25
  },
