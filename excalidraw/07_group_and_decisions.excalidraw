   "link": null,
   "locked": false,
   "text": "The tool never guesses direction. The AI may suggest one, a person\nconfirms it, and it is recorded with who and when. Without a direction the\nstrategy is disabled, not defaulted.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The tool never guesses direction. The AI may suggest one, a person\nconfirms it, and it is recorded with who and when. Without a direction the\nstrategy is disabled, not defaulted.",
   "autoResize": true,
   "lineHeight": 1.25
  },
