   "seed": 452730065,
   "version": 1,
   "versionNonce": 1437644733,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  M5 \"30 days after landing\" has a different condition from the others. The tool does not compare a condition to a number. Offer: keep separate and link, or add the condition to\nthe merged wording.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  M5 \"30 days after landing\" has a different condition from the others. The tool does not compare a condition to a number. Offer: keep separate and link, or add the condition to\nthe merged wording.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00321",
   "type": "text",
   "x": 34,
   "y": 1534,
   "width": 770.0000000000001,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00257",
   "roundness": null,
   "seed": 1598289472,
   "version": 1,
   "versionNonce": 754569418,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  M6 \"until the next maintenance cycle\" has no number. Offer: keep separate, ask the owner for a number, or include it in your own wording.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  M6 \"until the next maintenance cycle\" has no number. Offer: keep separate, ask the owner for a number, or include it in your own wording.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00322",
   "type": "text",
   "x": 34,
   "y": 1564,
   "width": 709.5000000000001,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00257",
   "roundness": null,
   "seed": 2091155685,
   "version": 1,
   "versionNonce": 1299332481,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Automatic strategies only ever act on members they can rank. The panel says how many it covered, and what happens to the rest.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Automatic strategies only ever act on members they can rank. The panel says how many it covered, and what happens to the rest.",
   "autoResize": true,
   "lineHeight": 1.25
  },
