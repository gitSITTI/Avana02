  {
   "id": "e00320",
   "type": "text",
   "x": 34,
   "y": 1504,
   "width": 979.0000000000001,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
