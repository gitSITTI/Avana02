   "versionNonce": 1116290443,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Sign-offs bind to a revision hash. Change the words and every earlier sign-off is stale, unless the change is whitespace only.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sign-offs bind to a revision hash. Change the words and every earlier sign-off is stale, unless the change is whitespace only.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
