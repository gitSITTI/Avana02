   "link": null,
   "locked": false,
   "text": "Correction to the idea of a median: for\nrequirements it is rarely right, because\nit can satisfy nobody's source need. It\nis available, gated and noted.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Correction to the idea of a median: for\nrequirements it is rarely right, because\nit can satisfy nobody's source need. It\nis available, gated and noted.",
   "autoResize": true,
   "lineHeight": 1.25
  },
