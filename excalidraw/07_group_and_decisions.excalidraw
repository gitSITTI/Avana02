   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Authorship is tracked by text, not by label: each revision stores how much of its words came from the AI draft.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Authorship is tracked by text, not by label: each revision stores how much of its words came from the AI draft.",
   "autoResize": true,
   "lineHeight": 1.25
  },
