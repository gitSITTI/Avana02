   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Two people editing at once make sibling revisions (R3a, R3b). Someone picks one on purpose and says why. Both stay in history.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two people editing at once make sibling revisions (R3a, R3b). Someone picks one on purpose and says why. Both stay in history.",
   "autoResize": true,
   "lineHeight": 1.25
  },
