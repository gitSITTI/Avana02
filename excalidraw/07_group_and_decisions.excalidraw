   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "AI makes a proposal with reasons. A\nperson makes the decision. A project may\nallow one-click accept in Lane A, never\nunattended bulk accept.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "AI makes a proposal with reasons. A\nperson makes the decision. A project may\nallow one-click accept in Lane A, never\nunattended bulk accept.",
   "autoResize": true,
   "lineHeight": 1.25
  },
