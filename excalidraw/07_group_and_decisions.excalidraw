   "link": null,
   "locked": false,
   "text": "Reverting is a new revision that copies an old one. History only grows.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Reverting is a new revision that copies an old one. History only grows.",
