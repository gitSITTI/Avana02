   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Exports and reports carry that label (\"AI-assisted, human-edited\"). They never say only \"approved\".",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Exports and reports carry that label (\"AI-assisted, human-edited\"). They never say only \"approved\".",
   "autoResize": true,
   "lineHeight": 1.25
  },
