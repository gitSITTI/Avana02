   "link": null,
   "locked": false,
   "text": "The Resolve panel is docked, not a\nseparate screen. Evidence and decision\nstay in view together, so there is no\ntab-hopping and no lost context. Four\nsteps: outcome, wording, preview,\nreason.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The Resolve panel is docked, not a\nseparate screen. Evidence and decision\nstay in view together, so there is no\ntab-hopping and no lost context. Four\nsteps: outcome, wording, preview,\nreason.",
   "autoResize": true,
   "lineHeight": 1.25
  },
