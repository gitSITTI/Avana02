  {
   "id": "e01269",
   "type": "text",
   "x": 1668,
   "y": 2758,
   "width": 797.5000000000001,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01214",
   "roundness": null,
   "seed": 215751110,
   "version": 1,
   "versionNonce": 446562216,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every suggestion and every decision is an event. Each event carries a fingerprint that includes the one before it, so editing an old entry breaks\nthe chain. Undo adds a new event; it never deletes one.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every suggestion and every decision is an event. Each event carries a fingerprint that includes the one before it, so editing an old entry breaks\nthe chain. Undo adds a new event; it never deletes one.",
   "autoResize": true,
   "lineHeight": 1.25
  },
