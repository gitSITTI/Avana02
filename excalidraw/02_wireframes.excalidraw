  {
   "id": "e01128",
   "type": "text",
   "x": 1668,
   "y": 2018,
   "width": 797.5000000000001,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
