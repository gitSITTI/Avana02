   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Queue is ordered safest first (Lane A,\nthen B, then C). Lane, relationship and\nstatus are all text labels, so colour is\nnever the only signal. It stays visible\nwhile the detail scrolls.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Queue is ordered safest first (Lane A,\nthen B, then C). Lane, relationship and\nstatus are all text labels, so colour is\nnever the only signal. It stays visible\nwhile the detail scrolls.",
   "autoResize": true,
   "lineHeight": 1.25
  },
