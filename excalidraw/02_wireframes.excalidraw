   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "One table, one scoring method,\nmechanical and AI side by side.\nProvenance marks (square or diamond)\nidentify each source. The AI row has a\nwide range because only four pairs were\njudged.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One table, one scoring method,\nmechanical and AI side by side.\nProvenance marks (square or diamond)\nidentify each source. The AI row has a\nwide range because only four pairs were\njudged.",
   "autoResize": true,
   "lineHeight": 1.25
  },
