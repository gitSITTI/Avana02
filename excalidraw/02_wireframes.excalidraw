  },
  {
   "id": "e00885",
   "type": "text",
   "x": 1702,
   "y": 952,
   "width": 536.8000000000001,
   "height": 10.0,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
