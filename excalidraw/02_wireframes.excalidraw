   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Mechanical against AI: where they agree\nis the strongest evidence; where they\ndisagree is what to label next.\nAgreement is explicitly not accuracy.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Mechanical against AI: where they agree\nis the strongest evidence; where they\ndisagree is what to label next.\nAgreement is explicitly not accuracy.",
   "autoResize": true,
   "lineHeight": 1.25
  },
