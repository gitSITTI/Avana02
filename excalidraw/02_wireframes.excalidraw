   "roundness": null,
   "seed": 1464875008,
   "version": 1,
   "versionNonce": 1533272979,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Suggestions are proposals. Each stays a draft until all four lenses sign off. Nothing is written back to the source model.",
   "fontSize": 8,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Suggestions are proposals. Each stays a draft until all four lenses sign off. Nothing is written back to the source model.",
   "autoResize": true,
   "lineHeight": 1.25
  },
