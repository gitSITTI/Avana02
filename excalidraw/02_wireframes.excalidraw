   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every suggestion source is scored the same way, so the mechanical methods and the AI can be compared fairly.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every suggestion source is scored the same way, so the mechanical methods and the AI can be compared fairly.",
   "autoResize": true,
   "lineHeight": 1.25
  },
