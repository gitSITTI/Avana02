   "seed": 643576462,
   "version": 1,
   "versionNonce": 1977991486,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "A cluster that mixes levels is a\nrequirement and its parent. Linking\nkeeps both, each with its own check at\nits own level. Supersede keeps the\nstricter one and marks the other; its\nitems then land at a different level,\nwhich the V says plainly.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A cluster that mixes levels is a\nrequirement and its parent. Linking\nkeeps both, each with its own check at\nits own level. Supersede keeps the\nstricter one and marks the other; its\nitems then land at a different level,\nwhich the V says plainly.",
   "autoResize": true,
   "lineHeight": 1.25
  },
