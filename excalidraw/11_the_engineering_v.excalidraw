   "link": null,
   "locked": false,
   "text": "WHY THESE RULES",
   "fontSize": 9,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WHY THESE RULES",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00538",
   "type": "text",
   "x": 60,
   "y": 3574,
   "width": 1294.7,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00495",
   "roundness": null,
   "seed": 1018084891,
   "version": 1,
   "versionNonce": 1600268331,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Level, method and item are all things a person can check in the source: a column, a field and a link. Nothing is inferred by a model. If a source has no parent links and no level field, the honest answer is \"cannot\nplace\", and every screen shows it that way instead of putting everything at level 1.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Level, method and item are all things a person can check in the source: a column, a field and a link. Nothing is inferred by a model. If a source has no parent links and no level field, the honest answer is \"cannot\nplace\", and every screen shows it that way instead of putting everything at level 1.",
   "autoResize": true,
   "lineHeight": 1.25
  },
