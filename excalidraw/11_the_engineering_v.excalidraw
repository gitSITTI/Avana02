   "link": null,
   "locked": false,
   "text": "Needs the dataset from \"reqin import --out-dir\". A broken dataset is\nrefused, not guessed at.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Needs the dataset from \"reqin import --out-dir\". A broken dataset is\nrefused, not guessed at.",
   "autoResize": true,
   "lineHeight": 1.25
  },
