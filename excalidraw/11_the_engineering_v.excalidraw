   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "A new wording has no history of its own,\nso every item on the replaced wordings,\nincluding the first, must move to it.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A new wording has no history of its own,\nso every item on the replaced wordings,\nincluding the first, must move to it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
