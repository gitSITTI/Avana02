   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The small V sits in the header of every\nworkspace screen and is a button: press\nit to open the V page. Its spoken label\ngives the three counts, so a screen\nreader hears what a sighted person sees.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The small V sits in the header of every\nworkspace screen and is a button: press\nit to open the V page. Its spoken label\ngives the three counts, so a screen\nreader hears what a sighted person sees.",
   "autoResize": true,
   "lineHeight": 1.25
  },
