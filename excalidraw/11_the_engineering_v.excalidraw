   "versionNonce": 385941188,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "In a cluster, the V says which level it\nsits at and which check matches it. A\ncluster that mixes levels says to link,\nnever merge, and the \"Merge into one\"\nchoice is not offered.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "In a cluster, the V says which level it\nsits at and which check matches it. A\ncluster that mixes levels says to link,\nnever merge, and the \"Merge into one\"\nchoice is not offered.",
   "autoResize": true,
   "lineHeight": 1.25
  },
