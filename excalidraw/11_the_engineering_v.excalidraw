   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Traced = a method AND at least one item.\nEverything else is a gap. Totals are the sum\nof the levels plus anything not placed, so\nnothing is lost.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Traced = a method AND at least one item.\nEverything else is a gap. Totals are the sum\nof the levels plus anything not placed, so\nnothing is lost.",
   "autoResize": true,
   "lineHeight": 1.25
  },
