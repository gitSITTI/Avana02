   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "A verify link counts for its target. If the\ntarget is outside the import but the source\nis inside, it counts for the source. Neither\nend inside: counted for no one, and\nreported.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A verify link counts for its target. If the\ntarget is outside the import but the source\nis inside, it counts for the source. Neither\nend inside: counted for no one, and\nreported.",
   "autoResize": true,
   "lineHeight": 1.25
  },
