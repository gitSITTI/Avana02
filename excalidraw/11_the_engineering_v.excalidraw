   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The glyph is the page in miniature:\ncircles down the left leg, squares up\nthe right, a diamond for the build in\nbetween. Shape carries the meaning, so\nit still reads in greyscale. The numbers\nbeside each level repeat it.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The glyph is the page in miniature:\ncircles down the left leg, squares up\nthe right, a diamond for the build in\nbetween. Shape carries the meaning, so\nit still reads in greyscale. The numbers\nbeside each level repeat it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
