   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Home shows the same V with three plain\nlines. The decided count is the one that\nstands, with the held ones named.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Home shows the same V with three plain\nlines. The decided count is the one that\nstands, with the held ones named.",
   "autoResize": true,
   "lineHeight": 1.25
  },
