   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "One of these is the parent of the other, a level up. Link them as parent and\nchild. Merging would leave level 1 with a check that proves nothing. Each\nstays with its own requirement.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One of these is the parent of the other, a level up. Link them as parent and\nchild. Merging would leave level 1 with a check that proves nothing. Each\nstays with its own requirement.",
   "autoResize": true,
   "lineHeight": 1.25
  },
