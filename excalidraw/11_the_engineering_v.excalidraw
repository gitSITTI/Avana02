   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Each level is a pair: the requirements\non the left, the check that matches them\non the right, joined by a dashed line.\nThe middle chip says in words if the\nlevel is in step, needs attention or is\nstill being consolidated.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each level is a pair: the requirements\non the left, the check that matches them\non the right, joined by a dashed line.\nThe middle chip says in words if the\nlevel is in step, needs attention or is\nstill being consolidated.",
   "autoResize": true,
   "lineHeight": 1.25
  },
