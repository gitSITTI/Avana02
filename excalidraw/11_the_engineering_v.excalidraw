   "link": null,
   "locked": false,
   "text": "Traced needs both halves. A method with\nno item is a promise with no evidence;\nan item with no method says nothing\nabout how it is checked.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Traced needs both halves. A method with\nno item is a promise with no evidence;\nan item with no method says nothing\nabout how it is checked.",
   "autoResize": true,
   "lineHeight": 1.25
  },
