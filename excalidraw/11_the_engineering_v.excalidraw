   "link": null,
   "locked": false,
   "text": "The app reads requirements and writes nothing back. It never changes a verification item. It tells you which ones must move.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The app reads requirements and writes nothing back. It never changes a verification item. It tells you which ones must move.",
