  },
  {
   "id": "e00006",
   "type": "text",
   "x": 40,
   "y": 100,
   "width": 514.25,
   "height": 41.25,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00002",
   "roundness": null,
   "seed": 1771487042,
   "version": 1,
   "versionNonce": 529030862,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Each level of requirements on the left is checked at the matching level on the right.\nConsolidating requirements changes the left side. This page shows what that does to\nthe right side, so nothing is left with nothing to verify it.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each level of requirements on the left is checked at the matching level on the right.\nConsolidating requirements changes the left side. This page shows what that does to\nthe right side, so nothing is left with nothing to verify it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
