   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "From the verification field: test, analysis,\ninspection, demonstration, or T, A, I, D.\nTwo methods count under each. Other text is\n\"other\". Empty is \"no method\".",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "From the verification field: test, analysis,\ninspection, demonstration, or T, A, I, D.\nTwo methods count under each. Other text is\n\"other\". Empty is \"no method\".",
   "autoResize": true,
   "lineHeight": 1.25
  },
