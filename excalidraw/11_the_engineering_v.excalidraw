   "version": 1,
   "versionNonce": 9819642,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Merging inside one level moves the items\nof the wording that goes onto the\nwording that stays. The count of items\nto move is the sum of the items on every\nrequirement the decision removes.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Merging inside one level moves the items\nof the wording that goes onto the\nwording that stays. The count of items\nto move is the sum of the items on every\nrequirement the decision removes.",
   "autoResize": true,
   "lineHeight": 1.25
  },
