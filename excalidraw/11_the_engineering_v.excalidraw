   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "By depth in the parent tree (root is level\n1; deeper than 4 counts at 4). Or from a\nfield you name: 1 to 4, L2, system,\ncomponent. No parent links and no field:\nnobody is placed, and it says so.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "By depth in the parent tree (root is level\n1; deeper than 4 counts at 4). Or from a\nfield you name: 1 to 4, L2, system,\ncomponent. No parent links and no field:\nnobody is placed, and it says so.",
   "autoResize": true,
   "lineHeight": 1.25
  },
