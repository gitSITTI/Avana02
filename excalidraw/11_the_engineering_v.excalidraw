   "seed": 1657572270,
   "version": 1,
   "versionNonce": 228610974,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Three numbers first: how much of the\nleft leg is decided, what must move\nbetween the legs, and how much of the\nright leg is traced. The decided count\nonly counts decisions that stand (stale\nor disputed ones are held back and said\nso).",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Three numbers first: how much of the\nleft leg is decided, what must move\nbetween the legs, and how much of the\nright leg is traced. The decided count\nonly counts decisions that stand (stale\nor disputed ones are held back and said\nso).",
   "autoResize": true,
   "lineHeight": 1.25
  },
