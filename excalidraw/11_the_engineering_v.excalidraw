   "link": null,
   "locked": false,
   "text": "The app works on the left leg only. It\nnever changes a verification item. It\nsays how many must move to a requirement\nthat survives.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The app works on the left leg only. It\nnever changes a verification item. It\nsays how many must move to a requirement\nthat survives.",
