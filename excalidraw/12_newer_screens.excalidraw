   "roundness": null,
   "seed": 760156841,
   "version": 1,
   "versionNonce": 344821997,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every requirement in scope, whether or not anything similar was found. Open any one, put another beside it if you like, and record what you decide.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every requirement in scope, whether or not anything similar was found. Open any one, put another beside it if you like, and record what you decide.",
   "autoResize": true,
   "lineHeight": 1.25
  },
