   "versionNonce": 1026252376,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Flight Control \u00b7 owner FCS team. Level 2 \u00b7 System. Checked by analysis at system\nverification, 1 verification item linked. Not in any cluster: four methods compared it\nwith every other requirement in its allocation and found nothing close.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Flight Control \u00b7 owner FCS team. Level 2 \u00b7 System. Checked by analysis at system\nverification, 1 verification item linked. Not in any cluster: four methods compared it\nwith every other requirement in its allocation and found nothing close.",
   "autoResize": true,
   "lineHeight": 1.25
  },
