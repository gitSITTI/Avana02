   "seed": 1071522933,
   "version": 1,
   "versionNonce": 1959213764,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The gate stops the application from knocking on\nthe door with the wrong text. A switch in a web\npage is not a security control; the wall is.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The gate stops the application from knocking on\nthe door with the wrong text. A switch in a web\npage is not a security control; the wall is.",
   "autoResize": true,
   "lineHeight": 1.25
  },
