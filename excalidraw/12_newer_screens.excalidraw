   "link": null,
   "locked": false,
   "text": "The rules are written twice, in the page\nand in the Python library the pipeline\nuses, and tested against one table of\ncases plus tens of thousands of\ngenerated inputs. That comparison found\na real difference when first run, which\nwas fixed.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The rules are written twice, in the page\nand in the Python library the pipeline\nuses, and tested against one table of\ncases plus tens of thousands of\ngenerated inputs. That comparison found\na real difference when first run, which\nwas fixed.",
   "autoResize": true,
   "lineHeight": 1.25
  },
