   "type": "text",
   "x": 202,
   "y": 1182,
   "width": 620.4000000000001,
   "height": 10.0,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
