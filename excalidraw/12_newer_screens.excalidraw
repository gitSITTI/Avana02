  {
   "id": "e00516",
   "type": "text",
   "x": 202,
   "y": 2262,
   "width": 620.4000000000001,
   "height": 10.0,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00462",
   "roundness": null,
   "seed": 1747792314,
   "version": 1,
   "versionNonce": 1189540168,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Suggestions are proposals. Each stays a draft until the lenses your policy requires have signed. Nothing is written back to the source model.",
   "fontSize": 8,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Suggestions are proposals. Each stays a draft until the lenses your policy requires have signed. Nothing is written back to the source model.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00517",
