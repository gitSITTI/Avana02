   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Three places: the page, the browser\u2019s\nown storage, and a file you can download\nand read back later. The file is plain\nJSON with the project it belongs to, a\ncount of what is in it and the record of\nevents.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Three places: the page, the browser\u2019s\nown storage, and a file you can download\nand read back later. The file is plain\nJSON with the project it belongs to, a\ncount of what is in it and the record of\nevents.",
   "autoResize": true,
   "lineHeight": 1.25
  },
