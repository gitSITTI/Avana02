   "link": null,
   "locked": false,
   "text": "One project-wide switch. Only the lead\ncan change it, and not from a lens\npreview. Switching off holds every\ngroup, and it is a recorded event in the\nchain with a fingerprint of the sheet.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One project-wide switch. Only the lead\ncan change it, and not from a lens\npreview. Switching off holds every\ngroup, and it is a recorded event in the\nchain with a fingerprint of the sheet.",
   "autoResize": true,
   "lineHeight": 1.25
  },
