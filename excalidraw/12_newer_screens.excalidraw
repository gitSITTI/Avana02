  {
   "id": "e00458",
   "type": "text",
   "x": 1568,
   "y": 1528.0,
   "width": 257.40000000000003,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
