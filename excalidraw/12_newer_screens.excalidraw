   "versionNonce": 842287046,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Suggestions are proposals. Each stays a draft until the lenses your policy requires have signed. Nothing is written back to the source model.",
   "fontSize": 8,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Suggestions are proposals. Each stays a draft until the lenses your policy requires have signed. Nothing is written back to the source model.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
