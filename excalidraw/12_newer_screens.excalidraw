   "text": "TWO TABS, A BLOCKED BROWSER, A FULL BROWSER",
   "fontSize": 9,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "TWO TABS, A BLOCKED BROWSER, A FULL BROWSER",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00718",
   "type": "text",
   "x": 880,
   "y": 3970,
   "width": 538.45,
   "height": 41.25,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
