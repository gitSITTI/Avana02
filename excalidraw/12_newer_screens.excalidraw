   "text": "The Flight Control Subsystem shall have a maximum mass of 12\nkilograms.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The Flight Control Subsystem shall have a maximum mass of 12\nkilograms.",
