   "seed": 1141801089,
   "version": 1,
   "versionNonce": 1803043271,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every fifth pair also goes to a second\nperson. When two people have labelled\nthe same pairs the page shows how often\nthey agree and the agreement beyond\nchance (kappa). A disagreement goes to\nthe lead; the original labels stay in\nthe record.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every fifth pair also goes to a second\nperson. When two people have labelled\nthe same pairs the page shows how often\nthey agree and the agreement beyond\nchance (kappa). A disagreement goes to\nthe lead; the original labels stay in\nthe record.",
   "autoResize": true,
   "lineHeight": 1.25
  },
