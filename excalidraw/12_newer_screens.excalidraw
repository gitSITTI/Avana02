   "roundness": null,
   "seed": 909687191,
   "version": 1,
   "versionNonce": 2108022223,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "A decision on a single requirement\ncounts on Results, the V and the ledger\nexactly as a cluster decision does. The\nrules live in one file, so nothing\ncounts it a second way.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A decision on a single requirement\ncounts on Results, the V and the ledger\nexactly as a cluster decision does. The\nrules live in one file, so nothing\ncounts it a second way.",
   "autoResize": true,
   "lineHeight": 1.25
  },
