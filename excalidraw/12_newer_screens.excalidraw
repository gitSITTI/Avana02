   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Sharing between people is the reference\nserver\u2019s job, not this page\u2019s. Until the\npage is connected to it, each browser\nand each file is its own copy. Say so to\nanyone who asks.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sharing between people is the reference\nserver\u2019s job, not this page\u2019s. Until the\npage is connected to it, each browser\nand each file is its own copy. Say so to\nanyone who asks.",
   "autoResize": true,
   "lineHeight": 1.25
  },
