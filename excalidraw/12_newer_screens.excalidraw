  {
   "id": "e00452",
   "type": "text",
   "x": 1568,
   "y": 1275.0,
   "width": 264.0,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
