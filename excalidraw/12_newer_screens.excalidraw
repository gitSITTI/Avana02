   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Not encrypted. Not tamper-proof: the page\u2019s fingerprints are a short demonstration hash that finds accidents and hand edits. Not a backup: clearing\nthe browser\u2019s site data removes the browser copy. Save a file.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not encrypted. Not tamper-proof: the page\u2019s fingerprints are a short demonstration hash that finds accidents and hand edits. Not a backup: clearing\nthe browser\u2019s site data removes the browser copy. Save a file.",
   "autoResize": true,
   "lineHeight": 1.25
  },
