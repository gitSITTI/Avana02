   "link": null,
   "locked": false,
   "text": "The deliberate-break scripts live in\ntools/mutation. A fast check in CI makes\nsure every break still matches the code,\nso the scripts cannot quietly stop\ntesting anything.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The deliberate-break scripts live in\ntools/mutation. A fast check in CI makes\nsure every break still matches the code,\nso the scripts cannot quietly stop\ntesting anything.",
