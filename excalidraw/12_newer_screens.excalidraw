   "link": null,
   "locked": false,
   "text": "It stays in this browser and is not encrypted, so a colleague on another computer does not see it. On a shared computer, start over\nwhen you finish. Sharing between people needs the server, which this prototype is not connected to.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It stays in this browser and is not encrypted, so a colleague on another computer does not see it. On a shared computer, start over\nwhen you finish. Sharing between people needs the server, which this prototype is not connected to.",
