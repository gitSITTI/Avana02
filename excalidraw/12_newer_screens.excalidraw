   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Six checks stand between a file and your\nwork. A file that fails one changes\nnothing. These were shown to fail on\npurpose: a wrong format, another\nproject, an edited record, a changed\nsheet, a file the screens cannot draw.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Six checks stand between a file and your\nwork. A file that fails one changes\nnothing. These were shown to fail on\npurpose: a wrong format, another\nproject, an edited record, a changed\nsheet, a file the screens cannot draw.",
   "autoResize": true,
   "lineHeight": 1.25
  },
