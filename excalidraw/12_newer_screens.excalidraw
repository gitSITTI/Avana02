   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Each \u201cPass\u201d is something a test fails\non. Each \u201cOpen\u201d is something nobody has\nchecked or that cannot be checked from\nhere. Both kinds are shown, on purpose.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each \u201cPass\u201d is something a test fails\non. Each \u201cOpen\u201d is something nobody has\nchecked or that cannot be checked from\nhere. Both kinds are shown, on purpose.",
   "autoResize": true,
   "lineHeight": 1.25
  },
