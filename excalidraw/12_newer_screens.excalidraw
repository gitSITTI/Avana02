   "versionNonce": 2047978884,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Two tabs of one browser cannot write over each other: the tab that notices the other one\nsaved stops saving and asks whose work stands. A blocked or full browser says so in words\nand says to save a file. The page keeps working.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two tabs of one browser cannot write over each other: the tab that notices the other one\nsaved stops saving and asks whose work stands. A blocked or full browser says so in words\nand says to save a file. The page keeps working.",
   "autoResize": true,
   "lineHeight": 1.25
  },
