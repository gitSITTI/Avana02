   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The reference server (reqin/src/reqin/server) is the shared one: one copy, who may change what, no silent overwrites, and a record\nthat verifies with SHA-256. It has its own tests. This page is not connected to it yet, so two people in two browsers each have their\nown copy.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The reference server (reqin/src/reqin/server) is the shared one: one copy, who may change what, no silent overwrites, and a record\nthat verifies with SHA-256. It has its own tests. This page is not connected to it yet, so two people in two browsers each have their\nown copy.",
   "autoResize": true,
   "lineHeight": 1.25
  },
