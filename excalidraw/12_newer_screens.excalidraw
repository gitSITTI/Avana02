   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The sheet records what the approvers\nwere told: model, where it runs, whether\ntext leaves, what is kept and for how\nlong, the highest marking approved, what\nto do with an unmarked requirement, who\nreviewed it and when. A sheet that\ncontradicts itself opens nothing.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The sheet records what the approvers\nwere told: model, where it runs, whether\ntext leaves, what is kept and for how\nlong, the highest marking approved, what\nto do with an unmarked requirement, who\nreviewed it and when. A sheet that\ncontradicts itself opens nothing.",
   "autoResize": true,
   "lineHeight": 1.25
  },
