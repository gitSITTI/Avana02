   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Most of the project is decided cluster\nby cluster. This panel is for a\nrequirement that stands alone: nothing\nsimilar was found, or a person took it\nout of its cluster. Any other\nrequirement can be put beside it first.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Most of the project is decided cluster\nby cluster. This panel is for a\nrequirement that stands alone: nothing\nsimilar was found, or a person took it\nout of its cluster. Any other\nrequirement can be put beside it first.",
   "autoResize": true,
   "lineHeight": 1.25
  },
