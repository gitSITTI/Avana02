   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Sample labels are made up from a rule\nthat knows how the demonstration was\nmade. They are marked as samples on\nevery screen and in the file. Remove\nthem before relying on any figure.\nNothing here has been used on a real\nprogram.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sample labels are made up from a rule\nthat knows how the demonstration was\nmade. They are marked as samples on\nevery screen and in the file. Remove\nthem before relying on any figure.\nNothing here has been used on a real\nprogram.",
   "autoResize": true,
   "lineHeight": 1.25
