   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Blind on purpose. The card never says\nwhether the app clustered the pair, what\nthe scores were or what the AI thought.\nA person who has seen the app\u2019s answer\ntends to agree with it, and that would\nmake the app look better than it is.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Blind on purpose. The card never says\nwhether the app clustered the pair, what\nthe scores were or what the AI thought.\nA person who has seen the app\u2019s answer\ntends to agree with it, and that would\nmake the app look better than it is.",
   "autoResize": true,
   "lineHeight": 1.25
  },
