   "versionNonce": 2129964055,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The trace map lists what hangs on a\nremoved requirement: its verification\nitems, the requirements below it, its\nbaseline. The checks make the rows add\nup to the V\u2019s numbers. This prototype is\nnot connected to the tools that hold\nthose links; it lists what to change in\nthem.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The trace map lists what hangs on a\nremoved requirement: its verification\nitems, the requirements below it, its\nbaseline. The checks make the rows add\nup to the V\u2019s numbers. This prototype is\nnot connected to the tools that hold\nthose links; it lists what to change in\nthem.",
   "autoResize": true,
   "lineHeight": 1.25
  },
