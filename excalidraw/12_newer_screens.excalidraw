   "link": null,
   "locked": false,
   "text": "Not a wall. The wall is the network: no\nroute from the model host to the\ninternet, no logging at the model host\nthat the sheet does not describe, a\ngateway only the pipeline can reach.\nThat is for IT and security to build; no\npage can.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not a wall. The wall is the network: no\nroute from the model host to the\ninternet, no logging at the model host\nthat the sheet does not describe, a\ngateway only the pipeline can reach.\nThat is for IT and security to build; no\npage can.",
   "autoResize": true,
   "lineHeight": 1.25
  },
