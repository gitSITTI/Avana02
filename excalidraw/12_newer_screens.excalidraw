   "link": null,
   "locked": false,
   "text": "The card sits on Home. Nothing to press:\ndecide something and it is kept a moment\nlater. The card says when, and how many\ndecisions, sign-offs, hand-offs and\nlabels that is.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The card sits on Home. Nothing to press:\ndecide something and it is kept a moment\nlater. The card says when, and how many\ndecisions, sign-offs, hand-offs and\nlabels that is.",
   "autoResize": true,
   "lineHeight": 1.25
  },
