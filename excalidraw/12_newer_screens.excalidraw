  {
   "id": "e00188",
   "type": "text",
   "x": 1568,
   "y": 358.0,
   "width": 264.0,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1290329122,
   "version": 1,
   "versionNonce": 2090577793,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "A plain random sample would hold less\nthan one cluster pair, because 1,294 of\n778,128 pairs are in a cluster. So the\npairs are drawn from four groups on\npurpose and each group is weighted by\nthe pairs it stands for. Precision and\nrecall come with a 95 percent range, not\njust a middle.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A plain random sample would hold less\nthan one cluster pair, because 1,294 of\n778,128 pairs are in a cluster. So the\npairs are drawn from four groups on\npurpose and each group is weighted by\nthe pairs it stands for. Precision and\nrecall come with a 95 percent range, not\njust a middle.",
   "autoResize": true,
   "lineHeight": 1.25
  },
