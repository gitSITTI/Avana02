   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Say whether two requirements are the same. Your labels turn the precision and recall on Methods and metrics from placeholders into measurements. You will not see what the app or the\nAI thought of a pair.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Say whether two requirements are the same. Your labels turn the precision and recall on Methods and metrics from placeholders into measurements. You will not see what the app or the\nAI thought of a pair.",
