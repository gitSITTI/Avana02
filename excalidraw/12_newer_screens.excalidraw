   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Five outcomes: keep as written, keep\nwith new wording, drop it, not a\nrequirement, ask the owner. \u201cAsk the\nowner\u201d changes nothing in the counts.\nNew wording gets the same checks a\ncluster\u2019s wording gets: a lost number,\nan incompatible unit, a flipped \u201cnot\u201d or\na lost \u201cshall\u201d blocks it.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Five outcomes: keep as written, keep\nwith new wording, drop it, not a\nrequirement, ask the owner. \u201cAsk the\nowner\u201d changes nothing in the counts.\nNew wording gets the same checks a\ncluster\u2019s wording gets: a lost number,\nan incompatible unit, a flipped \u201cnot\u201d or\na lost \u201cshall\u201d blocks it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
