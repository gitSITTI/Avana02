  },
  {
   "id": "e00358",
   "type": "text",
   "x": 608,
   "y": 1424,
   "width": 425.70000000000005,
   "height": 33.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
