   "text": "Five design changes this forces",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Five design changes this forces",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01529",
   "type": "text",
   "x": 34,
   "y": 5114,
   "width": 484.00000000000006,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 1841274741,
   "version": 1,
   "versionNonce": 998063112,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "1   Block pairs by allocation, owner or extracted parameter before scoring text.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1   Block pairs by allocation, owner or extracted parameter before scoring text.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01530",
   "type": "text",
   "x": 34,
   "y": 5144,
   "width": 369.05,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 787755770,
   "version": 1,
   "versionNonce": 333072479,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "2   Average-link or similar. Never single-link, which chains.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2   Average-link or similar. Never single-link, which chains.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01531",
   "type": "text",
   "x": 34,
   "y": 5174,
   "width": 580.8000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 926508578,
   "version": 1,
   "versionNonce": 211879414,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "3   Oversized guard: more than 12 members becomes an \"oversized\" state that must be split first.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "3   Oversized guard: more than 12 members becomes an \"oversized\" state that must be split first.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01532",
   "type": "text",
   "x": 34,
   "y": 5204,
   "width": 562.6500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 830498247,
   "version": 1,
   "versionNonce": 1897748020,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "4   Member-level review: peel one member out of a group instead of rejecting the whole group.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4   Member-level review: peel one member out of a group instead of rejecting the whole group.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01533",
