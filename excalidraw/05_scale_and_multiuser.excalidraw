   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Policy matrix: the required lenses\ndepend on lane, whether wording changed,\nwhether owners differ, and whether\nanything is baselined.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Policy matrix: the required lenses\ndepend on lane, whether wording changed,\nwhether owners differ, and whether\nanything is baselined.",
   "autoResize": true,
   "lineHeight": 1.25
  },
