   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Role matrix: four roles are enough.\nReviewer, lead, admin and observer.\n\"Sign for a lens\" is the only permission\ntied to who you are.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Role matrix: four roles are enough.\nReviewer, lead, admin and observer.\n\"Sign for a lens\" is the only permission\ntied to who you are.",
   "autoResize": true,
   "lineHeight": 1.25
  },
