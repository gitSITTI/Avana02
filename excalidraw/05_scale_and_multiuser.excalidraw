   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every decision carries the version it\nwas made on. If the version moved, the\nreviewer sees what changed before\nanything is saved.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every decision carries the version it\nwas made on. If the version moved, the\nreviewer sees what changed before\nanything is saved.",
   "autoResize": true,
   "lineHeight": 1.25
  },
