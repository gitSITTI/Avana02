   "text": "Edits never overwrite each other.\nConcurrent edits become sibling\nrevisions and one is chosen on purpose.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Edits never overwrite each other.\nConcurrent edits become sibling\nrevisions and one is chosen on purpose.",
