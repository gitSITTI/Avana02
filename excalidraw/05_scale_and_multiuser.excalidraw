   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Why: UX and NU lenses judge wording and comprehension. They matter when wording is new, so they sign then. SE and PE judge every change. At\n250 clusters this takes about 600 sign-offs instead of 1,000 (see S6).",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why: UX and NU lenses judge wording and comprehension. They matter when wording is new, so they sign then. SE and PE judge every change. At\n250 clusters this takes about 600 sign-offs instead of 1,000 (see S6).",
   "autoResize": true,
   "lineHeight": 1.25
  },
