   "x": 34,
   "y": 5234,
   "width": 605.0,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
