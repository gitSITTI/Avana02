   "link": null,
   "locked": false,
   "text": "The list is windowed, so 250 clusters or\n1,500 requirements cost the same to\ndraw. Search matches ID, text and\nextracted parameters.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The list is windowed, so 250 clusters or\n1,500 requirements cost the same to\ndraw. Search matches ID, text and\nextracted parameters.",
   "autoResize": true,
   "lineHeight": 1.25
