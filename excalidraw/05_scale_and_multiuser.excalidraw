   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Compute is not the constraint. The costly stages (cross-encoder, NLI, AI judge) only ever see a shortlist. The all-\npairs matrix is dense, fine to a few thousand; beyond that use sparse top-k.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Compute is not the constraint. The costly stages (cross-encoder, NLI, AI judge) only ever see a shortlist. The all-\npairs matrix is dense, fine to a few thousand; beyond that use sparse top-k.",
   "autoResize": true,
   "lineHeight": 1.25
  },
