   "versionNonce": 928932414,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "5   Pilot on one allocation (about 100 to 200 requirements) to replace every assumption below with a\nmeasurement.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
