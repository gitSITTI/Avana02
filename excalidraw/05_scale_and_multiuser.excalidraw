   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Hours \u00b7 sign-offs. SE time per cluster: lane A 1.5 min, B 4, C 8, with a 40/45/15 mix. Each other sign-off 1 min.\nMatrix: PE on B, C and 20% of A; UX and NU on the 35% of clusters with new wording. 1,487 requirements likely\nyield 50 to 350 clusters: 50 is the prototype ratio, 350 the synthetic worst case.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Hours \u00b7 sign-offs. SE time per cluster: lane A 1.5 min, B 4, C 8, with a 40/45/15 mix. Each other sign-off 1 min.\nMatrix: PE on B, C and 20% of A; UX and NU on the 35% of clusters with new wording. 1,487 requirements likely\nyield 50 to 350 clusters: 50 is the prototype ratio, 350 the synthetic worst case.",
   "autoResize": true,
   "lineHeight": 1.25
  },
