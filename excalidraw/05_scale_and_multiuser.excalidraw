  },
  {
   "id": "e01524",
   "type": "text",
   "x": 740,
   "y": 5126,
   "width": 676.5,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 103563824,
   "version": 1,
   "versionNonce": 902985700,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Blocking keeps 97% of the planted pairs. The allocation is known exactly here, and real allocation fields are messier. The\nsynthetic data is heavily templated (\"The X shall\u2026\"), which is the worst case for text similarity and probably harsher than\nreal data. Treat 28% pair precision as a floor to beat, not a forecast.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Blocking keeps 97% of the planted pairs. The allocation is known exactly here, and real allocation fields are messier. The\nsynthetic data is heavily templated (\"The X shall\u2026\"), which is the worst case for text similarity and probably harsher than\nreal data. Treat 28% pair precision as a floor to beat, not a forecast.",
   "autoResize": true,
   "lineHeight": 1.25
  },
