   "link": null,
   "locked": false,
   "text": "Bulk actions are limited to assigning\nand opening a stack. Decisions stay one\ncluster at a time unless a project turns\non policy-gated lane A acceptance.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Bulk actions are limited to assigning\nand opening a stack. Decisions stay one\ncluster at a time unless a project turns\non policy-gated lane A acceptance.",
   "autoResize": true,
   "lineHeight": 1.25
