   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Will it hold at 1,000 to 1,500 requirements?",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Will it hold at 1,000 to 1,500 requirements?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01459",
   "type": "text",
   "x": 20,
   "y": 4812,
   "width": 1359.6000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 1599754338,
   "version": 1,
   "versionNonce": 558644910,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Short answer: the computing holds easily. Plain text similarity does not. Structure first, then similarity, fixes it. All figures below are from synthetic requirements, so they show behaviour, not accuracy.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Short answer: the computing holds easily. Plain text similarity does not. Structure first, then similarity, fixes it. All figures below are from synthetic requirements, so they show behaviour, not accuracy.",
   "autoResize": true,
   "lineHeight": 1.25
  },
