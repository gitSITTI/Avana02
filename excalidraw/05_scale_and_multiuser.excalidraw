   "link": null,
   "locked": false,
   "text": "Chaining is the real scale problem. One\nblob of 675 requirements is\nunreviewable. Blocking plus average-link\nbrings the largest cluster to 14.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Chaining is the real scale problem. One\nblob of 675 requirements is\nunreviewable. Blocking plus average-link\nbrings the largest cluster to 14.",
