   "autoResize": false,
   "lineHeight": 1.25
  },
  {
   "id": "e01584",
   "type": "text",
   "x": 20,
   "y": 5560,
   "width": 183.6,
   "height": 11.25,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 220772325,
   "version": 1,
   "versionNonce": 1473226252,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "RISKS THE SCALE TEST DID NOT COVER",
   "fontSize": 9,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "RISKS THE SCALE TEST DID NOT COVER",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01585",
   "type": "text",
   "x": 20,
   "y": 5586,
   "width": 1004.3000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 822492122,
   "version": 1,
   "versionNonce": 1647746700,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Real requirements are less templated than the synthetic set, so text similarity may do better. It may also do worse where paraphrase and unit conversion are heavy.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Real requirements are less templated than the synthetic set, so text similarity may do better. It may also do worse where paraphrase and unit conversion are heavy.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01586",
   "type": "text",
   "x": 20,
   "y": 5628,
   "width": 1331.0,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 2056145961,
   "version": 1,
   "versionNonce": 512143395,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Embeddings, cross-encoder and NLI were not run here (no models offline). Their cost is a function of shortlist size: at about 3,000 to 5,000 pairs it is minutes on a GPU and tens of minutes on CPU (order of magnitude,\nunverified).",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Embeddings, cross-encoder and NLI were not run here (no models offline). Their cost is a function of shortlist size: at about 3,000 to 5,000 pairs it is minutes on a GPU and tens of minutes on CPU (order of magnitude,\nunverified).",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01587",
   "type": "text",
   "x": 20,
   "y": 5670,
   "width": 877.2500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 1746845302,
   "version": 1,
   "versionNonce": 1401136952,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  AI judge cost scales with the uncertain band. Cap it per run and cache results by content hash so a re-run only pays for changed requirements.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  AI judge cost scales with the uncertain band. Cap it per run and cache results by content hash so a re-run only pays for changed requirements.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01588",
   "type": "text",
   "x": 20,
   "y": 5712,
   "width": 792.5500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01456",
   "roundness": null,
   "seed": 1985594956,
   "version": 1,
   "versionNonce": 935463227,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Reviewer fatigue is real: 20 hours of review is not one sitting. Packets and resumable sessions (S1) matter more than raw speed.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Reviewer fatigue is real: 20 hours of review is not one sitting. Packets and resumable sessions (S1) matter more than raw speed.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01456",
   "type": "frame",
   "x": 0,
   "y": 4760,
   "width": 1500,
   "height": 1070,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1119887772,
   "version": 1,
   "versionNonce": 1067164168,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "name": "S6 \u00b7 Will it hold at 1,000 to 1,500? What we measured and what we assumed"
  },
  {
