   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The prototype let anyone switch lens and\nsign. With real users, lens comes from\nidentity and \"preview as\" is read only.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The prototype let anyone switch lens and\nsign. With real users, lens comes from\nidentity and \"preview as\" is read only.",
   "autoResize": true,
   "lineHeight": 1.25
  },
