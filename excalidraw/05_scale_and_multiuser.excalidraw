   "link": null,
   "locked": false,
   "text": "Sign-offs bind to a specific revision.\nChange the text and every affected sign-\noff becomes stale.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sign-offs bind to a specific revision.\nChange the text and every affected sign-\noff becomes stale.",
