   "originalText": "Identity and lenses",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01442",
   "type": "text",
   "x": 854,
   "y": 4532,
   "width": 528.0,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e01273",
   "roundness": null,
   "seed": 482520834,
   "version": 1,
   "versionNonce": 178393302,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Users sign in through your own identity provider (for example GitLab as an OIDC provider). Lens\nassignments come from that identity, not a free switch, so nobody can sign as a lens they do not\nhold. Leads can \"preview as\" another lens, read only.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Users sign in through your own identity provider (for example GitLab as an OIDC provider). Lens\nassignments come from that identity, not a free switch, so nobody can sign as a lens they do not\nhold. Leads can \"preview as\" another lens, read only.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e01443",
