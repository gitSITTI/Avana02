   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Rules that never change\n1  AI output cannot write to approved fields\n2  Variants and conflicts are never auto-merged\n3  Skip is always available\n4  Undo adds an event, never deletes one\n5  Every transition is one audit event",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e00129",
   "originalText": "Rules that never change\n1  AI output cannot write to approved fields\n2  Variants and conflicts are never auto-merged\n3  Skip is always available\n4  Undo adds an event, never deletes one\n5  Every transition is one audit event",
   "autoResize": false,
   "lineHeight": 1.25
  },
