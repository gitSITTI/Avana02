   "locked": false,
   "text": "\u2022  No state is colour alone: each has a word or a shape.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  No state is colour alone: each has a word or a shape.",
