   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The assistant is tested like any other model",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The assistant is tested like any other model",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00491",
   "type": "text",
   "x": 754,
   "y": 2550,
   "width": 445.50000000000006,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
