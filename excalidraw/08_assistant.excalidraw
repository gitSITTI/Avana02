   "versionNonce": 2144423161,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Recall is the \"someone who remembers\"\njob: prior decisions, revisions and\nnotes you may not have seen. It is only\nas good as the ledger, which is why the\nledger is structured.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Recall is the \"someone who remembers\"\njob: prior decisions, revisions and\nnotes you may not have seen. It is only\nas good as the ledger, which is why the\nledger is structured.",
   "autoResize": true,
   "lineHeight": 1.25
  },
