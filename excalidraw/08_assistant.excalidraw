   "link": null,
   "locked": false,
   "text": "A draft is a proposal card. It carries a\nbubble mark, the guard results, and two\nbuttons: use it as your own wording (it\nopens the editor), or discard. There is\nno \"apply\".",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A draft is a proposal card. It carries a\nbubble mark, the guard results, and two\nbuttons: use it as your own wording (it\nopens the editor), or discard. There is\nno \"apply\".",
   "autoResize": true,
   "lineHeight": 1.25
  },
