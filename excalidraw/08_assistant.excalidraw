   "roundness": null,
   "seed": 380580462,
   "version": 1,
   "versionNonce": 999994828,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Questions, answers and sources opened are logged so the team can see where it is not helping.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Questions, answers and sources opened are logged so the team can see where it is not helping.",
   "autoResize": true,
   "lineHeight": 1.25
  },
