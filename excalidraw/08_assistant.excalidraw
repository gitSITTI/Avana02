   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Heads-up cards are retrieved from the\nledger and the traces by the\napplication. They are not written by the\nmodel, so they are there even if you\nnever open the chat.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Heads-up cards are retrieved from the\nledger and the traces by the\napplication. They are not written by the\nmodel, so they are there even if you\nnever open the chat.",
   "autoResize": true,
   "lineHeight": 1.25
  },
