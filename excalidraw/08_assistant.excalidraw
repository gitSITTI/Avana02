   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Authoring is propose-only. Using a draft\ncreates an AI-origin revision (diamond)\nthat you then edit as a human (circle),\nso the chain in board 07 stays truthful.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Authoring is propose-only. Using a draft\ncreates an AI-origin revision (diamond)\nthat you then edit as a human (circle),\nso the chain in board 07 stays truthful.",
   "autoResize": true,
   "lineHeight": 1.25
  },
