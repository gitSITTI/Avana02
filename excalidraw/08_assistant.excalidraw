   "link": null,
   "locked": false,
   "text": "Chat transcripts are stored hashed, with the records each\nanswer used. They attach to a decision only if you choose.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Chat transcripts are stored hashed, with the records each\nanswer used. They attach to a decision only if you choose.",
