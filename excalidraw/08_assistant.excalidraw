   "link": null,
   "locked": false,
   "text": "A fourth mark, the bubble, for chat text. A draft you use\nbecomes an AI-origin revision (diamond). Your edits after that\nare human (circle).",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A fourth mark, the bubble, for chat text. A draft you use\nbecomes an AI-origin revision (diamond). Your edits after that\nare human (circle).",
   "autoResize": true,
   "lineHeight": 1.25
  },
