   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Tools are read-only, so an injected \"approve this\" has nothing to call.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Tools are read-only, so an injected \"approve this\" has nothing to call.",
