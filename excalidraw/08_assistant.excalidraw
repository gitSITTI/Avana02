   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "2  Acts as the user. Sees only what they\ncan open",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2  Acts as the user. Sees only what they\ncan open",
