   "link": null,
   "locked": false,
   "text": "A read-only assistant with no path to the decision service",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A read-only assistant with no path to the decision service",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00410",
   "type": "text",
   "x": 20,
   "y": 1910,
   "width": 1036.2,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00407",
   "roundness": null,
   "seed": 1451118628,
   "version": 1,
   "versionNonce": 2029035020,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "It acts as the signed-in user, calls read-only tools, and talks only to models inside your boundary. Self-hosted, in the same Podman or Docker compose stack.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It acts as the signed-in user, calls read-only tools, and talks only to models inside your boundary. Self-hosted, in the same Podman or Docker compose stack.",
   "autoResize": true,
   "lineHeight": 1.25
  },
