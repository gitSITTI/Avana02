   "text": "The workspace is unchanged. The drawer\nis optional and docks on the right, so\nthe evidence stays visible while you\ntalk.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
