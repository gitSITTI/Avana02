   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Context is explicit: which cluster,\nwhich lens, and what it can see. \"What\ncan it see?\" lists the records the\nassistant is allowed to read as you.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Context is explicit: which cluster,\nwhich lens, and what it can see. \"What\ncan it see?\" lists the records the\nassistant is allowed to read as you.",
   "autoResize": true,
   "lineHeight": 1.25
  },
