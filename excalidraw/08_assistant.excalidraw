   "link": null,
   "locked": false,
   "text": "It reasoned that M1 to M3 are minimums, so M4 (1 year)\nalso satisfies them, and it left M5 and M6 out because\nthey differ in condition and form.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It reasoned that M1 to M3 are minimums, so M4 (1 year)\nalso satisfies them, and it left M5 and M6 out because\nthey differ in condition and form.",
   "autoResize": true,
   "lineHeight": 1.25
  },
