   "versionNonce": 637894358,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Defending a decision means reading the\nrecord back, then arguing the opposite.\nIf the model never gave a reason, the\nassistant says so rather than make one\nup.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Defending a decision means reading the\nrecord back, then arguing the opposite.\nIf the model never gave a reason, the\nassistant says so rather than make one\nup.",
   "autoResize": true,
   "lineHeight": 1.25
  },
