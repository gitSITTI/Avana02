   "roundness": null,
   "seed": 2010459341,
   "version": 1,
   "versionNonce": 1292280490,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  A fixed question set per project type, with the records each answer must cite.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  A fixed question set per project type, with the records each answer must cite.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00492",
   "type": "text",
   "x": 754,
   "y": 2590,
   "width": 577.5,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00407",
   "roundness": null,
   "seed": 1214977393,
   "version": 1,
   "versionNonce": 1607698512,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Measured every release: citation accuracy, refusals when there is no source, and injection resistance.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Measured every release: citation accuracy, refusals when there is no source, and injection resistance.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00493",
   "type": "text",
   "x": 754,
   "y": 2630,
   "width": 467.50000000000006,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00407",
   "roundness": null,
   "seed": 1040924729,
   "version": 1,
   "versionNonce": 1429416668,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  A regression in any of these blocks the release, the same as a failing guard test.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  A regression in any of these blocks the release, the same as a failing guard test.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00494",
   "type": "text",
   "x": 754,
   "y": 2670,
   "width": 528.0,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
