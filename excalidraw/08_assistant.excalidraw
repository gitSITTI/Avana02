   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Requirement text is passed inside a marked block and labelled untrusted. The prompt says to ignore commands found in it.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Requirement text is passed inside a marked block and labelled untrusted. The prompt says to ignore commands found in it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00484",
   "type": "text",
   "x": 34,
   "y": 2590,
   "width": 407.00000000000006,
   "height": 12.5,
   "angle": 0,
