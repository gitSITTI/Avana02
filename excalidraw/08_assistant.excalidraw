   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Evidence before verdict. Every answer cites sources and says what it did not check. \"Argue\nthe other side\" is one click. No yes/no verdicts.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Evidence before verdict. Every answer cites sources and says what it did not check. \"Argue\nthe other side\" is one click. No yes/no verdicts.",
