   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The two you named first, understanding\nand deciding whether to revise, are the\nmost used. Neither writes anything.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The two you named first, understanding\nand deciding whether to revise, are the\nmost used. Neither writes anything.",
   "autoResize": true,
   "lineHeight": 1.25
  },
