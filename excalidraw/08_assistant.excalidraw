   "link": null,
   "locked": false,
   "text": "1  Read-only. No save, sign or export",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1  Read-only. No save, sign or export",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
