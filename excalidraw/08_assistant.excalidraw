   "versionNonce": 925862136,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every tool is read-only except\npropose_wording, which only creates a\ndraft card. Nothing here can save, sign\nor export.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every tool is read-only except\npropose_wording, which only creates a\ndraft card. Nothing here can save, sign\nor export.",
   "autoResize": true,
   "lineHeight": 1.25
  },
