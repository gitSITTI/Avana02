   "link": null,
   "locked": false,
   "text": "The dry run proves nothing was lost:\nrows read must equal rows kept, rejected\nand filtered. Anything else is a bug and\nstops the import.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The dry run proves nothing was lost:\nrows read must equal rows kept, rejected\nand filtered. Anything else is a bug and\nstops the import.",
   "autoResize": true,
   "lineHeight": 1.25
  },
