   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Statements found in prose carry a\nlocation (page and paragraph or table\nrow) so a person can look at the\noriginal in one click.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Statements found in prose carry a\nlocation (page and paragraph or table\nrow) so a person can look at the\noriginal in one click.",
   "autoResize": true,
   "lineHeight": 1.25
  },
