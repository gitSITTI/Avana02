   "locked": false,
   "text": "Verifying is deliberate and per record.\nUnverified records stay marked Extracted\neverywhere they appear. (Design\nproposal: confirm the rule with your\nprocess lens.)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Verifying is deliberate and per record.\nUnverified records stay marked Extracted\neverywhere they appear. (Design\nproposal: confirm the rule with your\nprocess lens.)",
   "autoResize": true,
   "lineHeight": 1.25
  },
