   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Trust level in words:  Structured = stable IDs and links.  Tabular = rows you map.  Parsed = light read of model text.  Extracted = found in prose, you verify each.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Trust level in words:  Structured = stable IDs and links.  Tabular = rows you map.  Parsed = light read of model text.  Extracted = found in prose, you verify each.",
