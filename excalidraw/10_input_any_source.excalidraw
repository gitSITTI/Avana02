   "link": null,
   "locked": false,
   "text": "The mapping table is the whole \"program\"\nfor a new spreadsheet. Changing a row\nedits a small text profile, not code.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The mapping table is the whole \"program\"\nfor a new spreadsheet. Changing a row\nedits a small text profile, not code.",
   "autoResize": true,
   "lineHeight": 1.25
  },
