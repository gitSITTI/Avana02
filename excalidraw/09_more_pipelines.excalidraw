   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Lint is the cheapest quality gate and\nthe one engineers already know from\nINCOSE and EARS. It runs on every\nrevision, including human and AI edits.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Lint is the cheapest quality gate and\nthe one engineers already know from\nINCOSE and EARS. It runs on every\nrevision, including human and AI edits.",
   "autoResize": true,
   "lineHeight": 1.25
  },
