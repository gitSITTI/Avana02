   "roundness": null,
   "seed": 180892814,
   "version": 1,
   "versionNonce": 2077721045,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Nothing goes to the source model without a branch and a human merge",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nothing goes to the source model without a branch and a human merge",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00444",
   "type": "text",
   "x": 20,
   "y": 2830,
   "width": 891.0000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00441",
   "roundness": null,
   "seed": 1475388750,
   "version": 1,
   "versionNonce": 2094750765,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The tool never edits your model in place. Approved decisions leave as packages, and the model changes only through a branch you review.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The tool never edits your model in place. Approved decisions leave as packages, and the model changes only through a branch you review.",
   "autoResize": true,
   "lineHeight": 1.25
  },
