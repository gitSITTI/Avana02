   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "These rules are what lets a team trust a\nlong-running review on a source that\nnever stops changing.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "These rules are what lets a team trust a\nlong-running review on a source that\nnever stops changing.",
   "autoResize": true,
   "lineHeight": 1.25
  },
