   "locked": false,
   "text": "The weekly monitor looks at the human override rate. A sudden rise means the data, the model or the source changed.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The weekly monitor looks at the human override rate. A sudden rise means the data, the model or the source changed.",
