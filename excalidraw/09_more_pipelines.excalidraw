   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The loop. Every decision made in review\ncan become a label, so the tool improves\nfrom use rather than from a one-off\ntuning exercise.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The loop. Every decision made in review\ncan become a label, so the tool improves\nfrom use rather than from a one-off\ntuning exercise.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
