   "seed": 1197715246,
   "version": 1,
   "versionNonce": 1942034200,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Seven rules for the gold set. The split-\nby-allocation rule is the one most often\nmissed and the one that flatters the\nnumbers most.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Seven rules for the gold set. The split-\nby-allocation rule is the one most often\nmissed and the one that flatters the\nnumbers most.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00442",
   "type": "rectangle",
   "x": 0,
