   "versionNonce": 1635734353,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Split by allocation, not by pair. If the same allocation is in training and testing, the scores look better than they are.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Split by allocation, not by pair. If the same allocation is in training and testing, the scores look better than they are.",
   "autoResize": true,
   "lineHeight": 1.25
  },
