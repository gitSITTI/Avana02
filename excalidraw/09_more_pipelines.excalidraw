   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Stratified: it holds easy and hard pairs from every allocation, relationship type and lane, not just the pairs reviewers happened to see first.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Stratified: it holds easy and hard pairs from every allocation, relationship type and lane, not just the pairs reviewers happened to see first.",
   "autoResize": true,
   "lineHeight": 1.25
  },
