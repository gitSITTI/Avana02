   "versionNonce": 208985229,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The report is a template. It stays empty\nuntil a gold set exists, which is the\nhonest state of the design today.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The report is a template. It stays empty\nuntil a gold set exists, which is the\nhonest state of the design today.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
