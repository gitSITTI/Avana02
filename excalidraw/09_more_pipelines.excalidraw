   "link": null,
   "locked": false,
   "text": "Seeded checks (known-answer clusters mixed in) are optional and off by default. They are for training and tool quality, not for scoring people.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Seeded checks (known-answer clusters mixed in) are optional and off by default. They are for training and tool quality, not for scoring people.",
