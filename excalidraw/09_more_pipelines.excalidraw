   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Thresholds are versioned configuration with a change log. Changing one needs a lead and an admin, and a re-run on the gold set first.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Thresholds are versioned configuration with a change log. Changing one needs a lead and an admin, and a re-run on the gold set first.",
   "autoResize": true,
   "lineHeight": 1.25
  },
