   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "S2 says \"No match found is not proof\". Search by parameter finds requirements that say the same thing in different words.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "S2 says \"No match found is not proof\". Search by parameter finds requirements that say the same thing in different words.",
