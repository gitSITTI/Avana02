   "link": null,
   "locked": false,
   "text": "How the thresholds earn their numbers",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "How the thresholds earn their numbers",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00331",
   "type": "text",
   "x": 20,
   "y": 1950,
   "width": 917.4000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00328",
   "roundness": null,
   "seed": 382798201,
   "version": 1,
   "versionNonce": 1734506367,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "No score is trusted until it is measured against human decisions. Reviewer decisions feed a gold set, and the gold set sets the thresholds.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No score is trusted until it is measured against human decisions. Reviewer decisions feed a gold set, and the gold set sets the thresholds.",
   "autoResize": true,
   "lineHeight": 1.25
  },
