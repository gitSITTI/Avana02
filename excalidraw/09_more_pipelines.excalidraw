  },
  {
   "id": "e00485",
   "type": "text",
   "x": 754,
   "y": 3254,
   "width": 653.4000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00441",
   "roundness": null,
   "seed": 880061049,
   "version": 1,
   "versionNonce": 803471196,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Which MSOSA release and SysML v2 API version you run. Write support differs and must be tested on a copy.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Which MSOSA release and SysML v2 API version you run. Write support differs and must be tested on a copy.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00486",
   "type": "text",
   "x": 754,
   "y": 3298,
   "width": 411.40000000000003,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00441",
   "roundness": null,
   "seed": 1870051198,
   "version": 1,
   "versionNonce": 47373131,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Whether ReqIF import in your MSOSA setup keeps relations and IDs.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Whether ReqIF import in your MSOSA setup keeps relations and IDs.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00487",
   "type": "text",
   "x": 754,
   "y": 3342,
   "width": 381.15000000000003,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00441",
   "roundness": null,
   "seed": 2109103174,
   "version": 1,
   "versionNonce": 344669726,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Who owns the merge: the program SE lead, or the model owner.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Who owns the merge: the program SE lead, or the model owner.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00488",
   "type": "text",
   "x": 754,
   "y": 3386,
   "width": 707.85,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00441",
   "roundness": null,
   "seed": 402107966,
   "version": 1,
   "versionNonce": 1592054274,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  How baselined requirements are changed: through your change board, outside this tool. The package only lists them.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  How baselined requirements are changed: through your change board, outside this tool. The package only lists them.",
   "autoResize": true,
   "lineHeight": 1.25
  },
