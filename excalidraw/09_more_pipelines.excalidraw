   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The ledger is a table of facts pulled\nfrom the text. It is mechanical, so it\nis cheap, repeatable and checkable, and\nit needs no model call.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The ledger is a table of facts pulled\nfrom the text. It is mechanical, so it\nis cheap, repeatable and checkable, and\nit needs no model call.",
