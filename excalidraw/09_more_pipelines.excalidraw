   "locked": false
  },
  {
   "id": "e00306",
   "type": "text",
   "x": 34,
   "y": 1598,
   "width": 210.0,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00210",
   "roundness": null,
   "seed": 232311354,
   "version": 1,
   "versionNonce": 2053744364,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Rules that keep this safe",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Rules that keep this safe",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00307",
   "type": "text",
   "x": 34,
   "y": 1628,
   "width": 456.50000000000006,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00210",
   "roundness": null,
   "seed": 14421481,
   "version": 1,
   "versionNonce": 1415910961,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  A refresh never deletes a decision, a note or a revision. It only changes state.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  A refresh never deletes a decision, a note or a revision. It only changes state.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00308",
   "type": "text",
   "x": 34,
   "y": 1656,
   "width": 594.0,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00210",
   "roundness": null,
   "seed": 494045194,
   "version": 1,
   "versionNonce": 1103895674,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Re-running costs money and time, so it is incremental: unchanged content hashes reuse earlier AI answers.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Re-running costs money and time, so it is incremental: unchanged content hashes reuse earlier AI answers.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00309",
   "type": "text",
   "x": 34,
   "y": 1684,
   "width": 621.5,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00210",
   "roundness": null,
   "seed": 404155792,
   "version": 1,
   "versionNonce": 1504471517,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  A \"keep it\" on a stale decision needs a reason and is logged. The decision then points at the new source text.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  A \"keep it\" on a stale decision needs a reason and is logged. The decision then points at the new source text.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00310",
   "type": "text",
   "x": 34,
   "y": 1712,
   "width": 671.0,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00210",
   "roundness": null,
   "seed": 848781021,
   "version": 1,
   "versionNonce": 1660640618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  Baselines are frozen. A refresh never touches an exported baseline snapshot, so a past export can always be reproduced.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  Baselines are frozen. A refresh never touches an exported baseline snapshot, so a past export can always be reproduced.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00311",
   "type": "text",
   "x": 34,
   "y": 1740,
   "width": 577.5,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#5c4400",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00210",
   "roundness": null,
   "seed": 1144593666,
   "version": 1,
   "versionNonce": 1551256997,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "\u2022  The comparison view can diff any two snapshots, so a program can say what changed between two reviews.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2022  The comparison view can diff any two snapshots, so a program can say what changed between two reviews.",
   "autoResize": true,
   "lineHeight": 1.25
  },
