   "locked": false
  },
  {
   "id": "e00443",
   "type": "text",
   "x": 20,
   "y": 2794,
   "width": 964.8,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
