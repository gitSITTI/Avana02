   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Two people label a sample (10 to 20%). Their agreement (for example Cohen's kappa) is the ceiling the tool can be expected to reach.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two people label a sample (10 to 20%). Their agreement (for example Cohen's kappa) is the ceiling the tool can be expected to reach.",
   "autoResize": true,
   "lineHeight": 1.25
  },
