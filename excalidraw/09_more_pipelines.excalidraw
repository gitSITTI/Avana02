   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Seven steps, mostly mechanical. The AI\nis used only on changed content, and\npeople are asked only about decisions\nthe change actually touches.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Seven steps, mostly mechanical. The AI\nis used only on changed content, and\npeople are asked only about decisions\nthe change actually touches.",
