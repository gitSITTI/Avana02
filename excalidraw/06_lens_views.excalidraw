   "link": null,
   "locked": false,
   "text": "Nothing about the evidence is hidden by\nlens. A lens changes what is shown first\nand what you are asked, not what is\ntrue.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nothing about the evidence is hidden by\nlens. A lens changes what is shown first\nand what you are asked, not what is\ntrue.",
