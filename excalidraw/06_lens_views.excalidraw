   "locked": false,
   "text": "Same members and draft. The UX view adds\nterm use across the whole project, so\none cluster is judged against the\nproject's language.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Same members and draft. The UX view adds\nterm use across the whole project, so\none cluster is judged against the\nproject's language.",
   "autoResize": true,
   "lineHeight": 1.25
  },
