   "locked": false,
   "text": "The New user lens is the only one that\nstarts from a blank mind. Blind-first is\non by default so the first read is\nclean.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The New user lens is the only one that\nstarts from a blank mind. Blind-first is\non by default so the first read is\nclean.",
