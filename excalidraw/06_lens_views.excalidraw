   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "The wording matches the project's terms\nand reads clearly to the people who use\nit.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The wording matches the project's terms\nand reads clearly to the people who use\nit.",
