   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "This change can be processed under our\nchange and trace process, and the record\nof how it was decided is complete.",
   "fontSize": 9,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This change can be processed under our\nchange and trace process, and the record\nof how it was decided is complete.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
