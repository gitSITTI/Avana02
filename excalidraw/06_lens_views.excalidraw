   "text": "The Flight Control Subsystem shall transmit a heartbeat\nmessage to the Mission Computer every 1 second.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The Flight Control Subsystem shall transmit a heartbeat\nmessage to the Mission Computer every 1 second.",
