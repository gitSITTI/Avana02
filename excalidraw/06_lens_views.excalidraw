  {
   "id": "e00111",
   "type": "text",
   "x": 520,
   "y": 431.25,
   "width": 955.9000000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00002",
   "roundness": null,
   "seed": 387101200,
   "version": 1,
   "versionNonce": 1926304201,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Who decides and who signs. The assigned reviewer (usually the SE) makes the group decision in the Resolve panel. The other three lenses do not re-decide. They\ncheck the draft from their own angle and sign, or request changes with a reason. This keeps one owner for each decision and four independent checks.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Who decides and who signs. The assigned reviewer (usually the SE) makes the group decision in the Resolve panel. The other three lenses do not re-decide. They\ncheck the draft from their own angle and sign, or request changes with a reason. This keeps one owner for each decision and four independent checks.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00112",
   "type": "text",
   "x": 520,
   "y": 499.25,
   "width": 144.0,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00002",
   "roundness": null,
   "seed": 83491249,
   "version": 1,
   "versionNonce": 1215309863,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Which lens do I get?",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Which lens do I get?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e00113",
   "type": "text",
   "x": 520,
   "y": 521.25,
   "width": 968.0000000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "e00002",
   "roundness": null,
   "seed": 1767164400,
   "version": 1,
   "versionNonce": 629500792,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "From your login (for example the group claim from GitLab OIDC). A person can hold more than one lens, but cannot sign two lenses on the same revision. Leads can\n\"preview as\" another lens, read only, to see what that reviewer sees.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "From your login (for example the group claim from GitLab OIDC). A person can hold more than one lens, but cannot sign two lenses on the same revision. Leads can\n\"preview as\" another lens, read only, to see what that reviewer sees.",
   "autoResize": true,
   "lineHeight": 1.25
  },
