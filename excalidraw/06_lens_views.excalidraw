   "link": null,
   "locked": false,
   "text": "Blind-first applies to the AI panel. For\nthe New user it is on by default,\nbecause a fresh, unanchored read is the\npoint of that lens.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Blind-first applies to the AI panel. For\nthe New user it is on by default,\nbecause a fresh, unanchored read is the\npoint of that lens.",
   "autoResize": true,
   "lineHeight": 1.25
  },
