  {
   "id": "e00105",
   "type": "text",
   "x": 648,
   "y": 378.5,
   "width": 183.15,
   "height": 33.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
