#!/bin/sh
# Blocks a commit whose message, author name or author email holds a term from your private list.
root=$(cd "$(dirname "$0")/.." && pwd)
py=${PYTHON:-python3}
command -v "$py" >/dev/null 2>&1 || py=python
command -v "$py" >/dev/null 2>&1 || { echo "commit-msg: no python3 or python on PATH, so this commit was blocked." >&2; exit 1; }
exec "$py" "$root/tools/denylist_check.py" message "$1"
